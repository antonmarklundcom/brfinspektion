# Neon Postgres — pooled connection string (use for DATABASE_URL, app runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/brfinspektion?sslmode=require"
# Neon Postgres — direct connection string (migrations only, prisma migrate deploy)
DIRECT_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/brfinspektion?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Email (Resend) — see architecture.md §1 for the SMTP fallback if the operator prefers Hostinger SMTP
RESEND_API_KEY=""
NOTIFY_EMAIL="anton@brfinspektion.se"

# Cron endpoint auth (architecture.md §6.4)
CRON_SECRET="generate-a-long-random-string"

# Analytics (architecture.md §6.2) — leave blank until operator supplies
NEXT_PUBLIC_GA_ID=""

# Google Ads conversion tag (strategy.md §6.2, §6.4 go-live checklist) — leave
# blank until the Ads account exists and the checklist is cleared. The two
# label vars are the per-conversion-action labels from the Ads UI
# ("AW-XXXXXXX/AbC-D_efG-h12"), not the full send_to string.
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_CALCULATOR_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=""

# Seed script (architecture.md §5) — used only by prisma/seed.ts, never commit real values
SEED_OWNER_EMAIL="owner@brfinspektion.se"
SEED_OWNER_PASSWORD="change-me-before-running-seed"
